# URL del WebSocket del servicio de monitoreo (Testigos IA).
# En desarrollo el REST va por el proxy de Vite; el WebSocket necesita la URL completa.
VITE_MONITOR_WS_URL=ws://localhost:8001

# Autenticación: "mock" (cualquier credencial válida, solo dev) o "http" (backend real).
# Por defecto: mock en `vite dev`, http en producción.
VITE_AUTH_MODE=mock
# Base de la API de auth (POST /auth/login -> { token, user: { email, name } }).
VITE_AUTH_API_URL=/api
